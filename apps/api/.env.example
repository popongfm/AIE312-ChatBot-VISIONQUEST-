# Copy to apps/api/.env and fill in. Never commit .env.
# Local values work with `docker compose up -d` from the repo root.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/visionquest
# Production (Supabase, Session pooler, see docs/deploy.md):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/visionquest_test
PORT=3000

# Gemini (Task 7). Get a key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
