# Local docker compose Postgres (docker compose up -d db)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/visionquest
# Neon: DATABASE_URL is the pooled (-pooler) URL; migrate prefers the direct URL below.
# `neon env pull` writes both into .env.local at the repo root. Leave empty for local docker.
DATABASE_URL_UNPOOLED=
GEMINI_API_KEY=
# Current free-tier model names: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
WEB_ORIGIN=http://localhost:5173
PORT=3000
